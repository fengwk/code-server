+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { mainWindow } from '../../base/browser/window.js';
+import type { IProductConfiguration } from '../../base/common/product.js';
+
+type NativeAction = { action: 'open-folder'; directory: string } | { action: 'new-window' | 'close-workspace' };
+
+export function postStudioNativeAction(view: NonNullable<IProductConfiguration['studioManagedView']>, action: NativeAction): void {
+	if (mainWindow.parent !== mainWindow) {
+		mainWindow.parent.postMessage({ type: 'kk-studio.ide.native-action', ...view, ...action }, mainWindow.location.origin);
+	}
+}
