+
+	async rebindView(viewId: string, fromBindingEpoch: string, bindingEpoch: string, workspacePath: string): Promise<ManagedViewRuntimeRebind> {
+		const record = this.records.get(viewId);
+		if (!record || record.bindingEpoch !== fromBindingEpoch || record.workspacePath !== workspacePath) {
+			throw new Error('view is not registered with this binding');
+		}
+		if (BigInt(bindingEpoch) <= BigInt(fromBindingEpoch)) {
+			throw new Error('rebind epoch must increase');
+		}
+		if (record.state !== 'OPEN' && record.state !== 'CLEANUP_FAILED') {
+			throw new Error(`view cannot rebind from state ${record.state}`);
+		}
