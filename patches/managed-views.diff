--- /dev/null
+++ b/lib/vscode/src/vs/server/node/managedViews.ts
@@ -0,0 +1,600 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { IPtyService } from '../../platform/terminal/common/terminal.js';
+import { ILogService } from '../../platform/log/common/log.js';
+
+/**
+ * Server-side ownership for managed code-server views.
+ *
+ * code-server owns the view registry and the HTTP/WebSocket routing. This
+ * tracker owns the resources that only the VS Code server can see: extension
+ * host processes, management connections and terminals in the shared PTY host.
+ * A close is only successful after every recorded handle reports actual exit.
+ */
+
+export type ManagedViewState = 'OPEN' | 'CLOSING' | 'CLEANUP_FAILED' | 'CLOSED';
+export type ManagedViewMode = 'normal' | 'discard' | 'expired';
+
+export interface ManagedViewContext {
+	viewId: string;
+	bindingEpoch: string;
+}
+
+export interface ManagedViewResourceFact {
+	id: string | number;
+	pid?: number;
+}
+
+export interface ManagedViewRuntimeInspection {
+	viewId: string;
+	bindingEpoch: string;
+	workspacePath: string;
+	state: ManagedViewState;
+	dirty: 'unknown';
+	draftBackup: { supported: false; reason: string };
+	managementConnections: ManagedViewResourceFact[];
+	extensionHosts: ManagedViewResourceFact[];
+	terminals: Array<{ id: number; pid?: number }>;
+	failures: string[];
+}
+
+export interface ManagedViewRuntimeRegistration {
+	viewId: string;
+	bindingEpoch: string;
+	workspacePath: string;
+	state: ManagedViewState;
+	created: boolean;
+}
+
+export interface ManagedViewRuntimeRebind {
+	state: 'OPEN' | 'CLEANUP_FAILED';
+	failures: string[];
+	releasedManagementConnections: number;
+	releasedExtensionHosts: number;
+	preservedTerminals: number;
+}
+
+export interface ManagedViewRuntimeClose {
+	state: 'CLOSED' | 'CLEANUP_FAILED';
+	failures: string[];
+	releasedManagementConnections: number;
+	releasedExtensionHosts: number;
+	releasedTerminals: number;
+}
+
+/** A disposable server resource with real exit evidence. */
+export interface ManagedExtensionHostHandle {
+	readonly id: string;
+	readonly pid?: number;
+	terminate(): Promise<void>;
+}
+
+export interface ManagedManagementHandle {
+	readonly id: string;
+	terminate(): Promise<void>;
+}
+
+interface TerminalHandle {
+	readonly id: number;
+	readonly pid?: number;
+	readonly exit: Promise<void>;
+	terminate(): Promise<void>;
+}
+
+interface ViewRecord {
+	viewId: string;
+	bindingEpoch: string;
+	workspacePath: string;
+	state: ManagedViewState;
+	management: Set<ManagedManagementHandle>;
+	extensionHosts: Set<ManagedExtensionHostHandle>;
+	terminals: Map<number, TerminalHandle>;
+	failures: string[];
+	/** Creates and extension-host starts admitted before CLOSING must settle first. */
+	pendingResources: number;
+	pendingWaiters: Set<() => void>;
+	closePromise?: Promise<ManagedViewRuntimeClose>;
+	lastClose?: ManagedViewRuntimeClose;
+}
+
+const CLEANUP_TIMEOUT_MS = 15_000;
+const DRAFT_BACKUP_REASON =
+	'code-server cannot observe renderer-only unsaved buffers; dirty is reported as unknown and close never claims the workspace is clean';
+
+function sameView(record: ViewRecord, viewId: string, bindingEpoch: string): boolean {
+	return record.viewId === viewId && record.bindingEpoch === bindingEpoch;
+}
+
+function timeoutError(): Error {
+	const error = new Error('managed resource did not report exit before the cleanup budget');
+	error.name = 'ManagedResourceExitTimeout';
+	return error;
+}
+
+function withTimeout(operation: Promise<void>, label: string): Promise<void> {
+	return new Promise<void>((resolve, reject) => {
+		const timer = setTimeout(() => reject(timeoutError()), CLEANUP_TIMEOUT_MS);
+		operation.then(
+			() => {
+				clearTimeout(timer);
+				resolve();
+			},
+			(error) => {
+				clearTimeout(timer);
+				reject(new Error(`${label}: ${error instanceof Error ? error.message : 'unknown error'}`));
+			}
+		);
+	});
+}
+
+export class ManagedViewTracker {
+	private readonly records = new Map<string, ViewRecord>();
+	private ptyService: IPtyService | undefined;
+
+	constructor(private readonly _logService: ILogService) { }
+
+	setPtyService(ptyService: IPtyService): void {
+		this.ptyService = ptyService;
+	}
+
+	accepts(viewId: string, bindingEpoch: string): boolean {
+		const record = this.records.get(viewId);
+		return !!record && record.bindingEpoch === bindingEpoch && record.state === 'OPEN';
+	}
+
+	/** Reserve a terminal creation before spawning the shell so close can wait for it. */
+	beginTerminalCreate(viewId: string, bindingEpoch: string): boolean {
+		return this.beginPendingResource(viewId, bindingEpoch);
+	}
+
+	endTerminalCreate(viewId: string, bindingEpoch: string): void {
+		this.endPendingResource(viewId, bindingEpoch);
+	}
+
+	/** Reserve an extension-host start so rebind/close cannot miss a late child process. */
+	beginExtensionHostStart(viewId: string, bindingEpoch: string): boolean {
+		return this.beginPendingResource(viewId, bindingEpoch);
+	}
+
+	endExtensionHostStart(viewId: string, bindingEpoch: string): void {
+		this.endPendingResource(viewId, bindingEpoch);
+	}
+
+	private beginPendingResource(viewId: string, bindingEpoch: string): boolean {
+		const record = this.records.get(viewId);
+		if (!record || record.bindingEpoch !== bindingEpoch || record.state !== 'OPEN') {
+			return false;
+		}
+		record.pendingResources++;
+		return true;
+	}
+
+	private endPendingResource(viewId: string, bindingEpoch: string): void {
+		const record = this.records.get(viewId);
+		if (!record || record.bindingEpoch !== bindingEpoch) {
+			return;
+		}
+		record.pendingResources = Math.max(0, record.pendingResources - 1);
+		if (record.pendingResources === 0) {
+			const waiters = [...record.pendingWaiters];
+			record.pendingWaiters.clear();
+			for (const waiter of waiters) {
+				waiter();
+			}
+		}
+	}
+
+	private waitForPendingResources(record: ViewRecord): Promise<void> {
+		if (record.pendingResources === 0) {
+			return Promise.resolve();
+		}
+		return new Promise<void>((resolve, reject) => {
+			let timer: ReturnType<typeof setTimeout>;
+			const finish = () => {
+				clearTimeout(timer);
+				record.pendingWaiters.delete(finish);
+				resolve();
+			};
+			timer = setTimeout(() => {
+				record.pendingWaiters.delete(finish);
+				reject(timeoutError());
+			}, CLEANUP_TIMEOUT_MS);
+			record.pendingWaiters.add(finish);
+		});
+	}
+
+	async registerView(viewId: string, bindingEpoch: string, workspacePath: string): Promise<ManagedViewRuntimeRegistration> {
+		const existing = this.records.get(viewId);
+		if (existing && existing.state !== 'CLOSED') {
+			if (!sameView(existing, viewId, bindingEpoch) || existing.workspacePath !== workspacePath) {
+				throw new Error('view is already registered with a different identity');
+			}
+			return { viewId, bindingEpoch, workspacePath, state: existing.state, created: false };
+		}
+		if (existing) {
+			// A completed close releases the identity for a new binding epoch. The
+			// new record starts with no inherited handles.
+			this.records.delete(viewId);
+		}
+		this.records.set(viewId, {
+			viewId,
+			bindingEpoch,
+			workspacePath,
+			state: 'OPEN',
+			management: new Set(),
+			extensionHosts: new Set(),
+			terminals: new Map(),
+			failures: [],
+			pendingResources: 0,
+			pendingWaiters: new Set()
+		});
+		this._logService.info(`[ManagedView] registered ${viewId} epoch ${bindingEpoch}`);
+		return { viewId, bindingEpoch, workspacePath, state: 'OPEN', created: true };
+	}
+
+	async inspectView(viewId: string, bindingEpoch: string): Promise<ManagedViewRuntimeInspection> {
+		const record = this.records.get(viewId);
+		if (!record || record.bindingEpoch !== bindingEpoch) {
+			throw new Error('view is not registered');
+		}
+		return this.inspection(record);
+	}
+
+	async listViews(): Promise<ManagedViewRuntimeInspection[]> {
+		return Array.from(this.records.values())
+			.filter((record) => record.state !== 'CLOSED')
+			.map((record) => this.inspection(record));
+	}
+
+	attachManagementConnection(viewId: string, bindingEpoch: string, handle: ManagedManagementHandle): boolean {
+		const record = this.records.get(viewId);
+		if (!record || record.bindingEpoch !== bindingEpoch || record.state !== 'OPEN') {
+			return false;
+		}
+		record.management.add(handle);
+		return true;
+	}
+
+	detachManagementConnection(viewId: string, bindingEpoch: string, handle: ManagedManagementHandle): void {
+		const record = this.records.get(viewId);
+		if (record && record.bindingEpoch === bindingEpoch) {
+			record.management.delete(handle);
+		}
+	}
+
+	attachExtensionHost(viewId: string, bindingEpoch: string, handle: ManagedExtensionHostHandle): boolean {
+		const record = this.records.get(viewId);
+		if (!record || record.bindingEpoch !== bindingEpoch || record.state !== 'OPEN') {
+			return false;
+		}
+		record.extensionHosts.add(handle);
+		return true;
+	}
+
+	detachExtensionHost(viewId: string, bindingEpoch: string, handle: ManagedExtensionHostHandle): void {
+		const record = this.records.get(viewId);
+		if (record && record.bindingEpoch === bindingEpoch) {
+			record.extensionHosts.delete(handle);
+		}
+	}
+
+	attachTerminal(viewId: string, bindingEpoch: string, id: number): boolean {
+		const record = this.records.get(viewId);
+		const ptyService = this.ptyService;
+		if (!record || record.bindingEpoch !== bindingEpoch || !ptyService || record.state === 'CLOSED') {
+			return false;
+		}
+		if (record.terminals.has(id)) {
+			return record.state === 'OPEN';
+		}
+		// Track the process even if the view started closing while the shell was
+		// being launched. The caller shuts it down; retaining the handle prevents
+		// an untracked shell and lets a close retry observe its actual exit.
+		const handle = this.createTerminalHandle(ptyService, id);
+		record.terminals.set(id, handle);
+		void handle.exit.then(() => {
+			if (record.terminals.get(id) === handle) {
+				record.terminals.delete(id);
+			}
+		});
+		return record.state === 'OPEN';
+	}
+
+	private createTerminalHandle(ptyService: IPtyService, id: number): TerminalHandle {
+		let pid: number | undefined;
+		let exited = false;
+		let resolveExit!: () => void;
+		const exit = new Promise<void>((resolve) => {
+			resolveExit = resolve;
+		});
+		const readyListener = ptyService.onProcessReady((event) => {
+			if (event.id === id) {
+				pid = event.event.pid;
+			}
+		});
+		let exitListener: { dispose(): void } = { dispose: () => undefined };
+		const markExited = () => {
+			if (exited) {
+				return;
+			}
+			exited = true;
+			readyListener.dispose();
+			exitListener.dispose();
+			resolveExit();
+		};
+		// The ready and exit events can fire before this ownership listener is
+		// attached. A missing process means the pty host has no live process.
+		void ptyService.listProcesses().then((processes) => {
+			const process = processes.find((candidate) => candidate.id === id);
+			if (process) {
