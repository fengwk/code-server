+		if (failures.length > 0) {
+			record.state = 'CLEANUP_FAILED';
+			record.failures = failures;
+			this._logService.error(`[ManagedView] rebind failed ${viewId}: ${failures.join('; ')}`);
+			return {
+				state: 'CLEANUP_FAILED',
+				failures,
+				releasedManagementConnections,
+				releasedExtensionHosts,
+				preservedTerminals: record.terminals.size
+			};
+		}
+
+		// Terminals and their PTY host state are deliberately retained. Only the
+		// binding epoch changes; new management connections and extension hosts
+		// attach to this same record after the call returns.
+		record.bindingEpoch = bindingEpoch;
+		record.state = 'OPEN';
+		record.failures = [];
+		this._logService.info(`[ManagedView] rebound ${viewId} epoch ${fromBindingEpoch} -> ${bindingEpoch}`);
+		return {
+			state: 'OPEN',
+			failures: [],
+			releasedManagementConnections,
+			releasedExtensionHosts,
+			preservedTerminals: record.terminals.size
+		};
+	}
+
+	async closeView(viewId: string, bindingEpoch: string, _mode: ManagedViewMode): Promise<ManagedViewRuntimeClose> {
+		const record = this.records.get(viewId);
+		if (!record || record.bindingEpoch !== bindingEpoch) {
+			throw new Error('view is not registered');
+		}
+		if (record.state === 'CLOSED') {
+			return record.lastClose ?? {
+				state: 'CLOSED',
+				failures: [],
+				releasedManagementConnections: 0,
+				releasedExtensionHosts: 0,
+				releasedTerminals: 0
+			};
+		}
+		if (record.closePromise) {
+			return record.closePromise;
+		}
+
+		record.state = 'CLOSING';
+		record.closePromise = this.performClose(record).finally(() => {
+			record.closePromise = undefined;
+		});
+		return record.closePromise;
+	}
+
+	private async performClose(record: ViewRecord): Promise<ManagedViewRuntimeClose> {
+		try {
+			await this.waitForPendingResources(record);
+		} catch (error) {
+			const message = `pending managed resources did not settle: ${error instanceof Error ? error.message : 'unknown error'}`;
+			record.state = 'CLEANUP_FAILED';
+			record.failures = [message];
+			this._logService.error(`[ManagedView] close failed ${record.viewId}: ${message}`);
+			return {
+				state: 'CLEANUP_FAILED',
+				failures: [message],
+				releasedManagementConnections: 0,
+				releasedExtensionHosts: 0,
+				releasedTerminals: 0
+			};
+		}
+		const management = [...record.management];
+		const extensionHosts = [...record.extensionHosts];
+		const terminals = [...record.terminals.values()];
+		const failures: string[] = [];
+		let releasedManagementConnections = 0;
+		let releasedExtensionHosts = 0;
+		let releasedTerminals = 0;
+
+		const outcomes = await Promise.allSettled([
+			...management.map((handle) => withTimeout(handle.terminate(), `management connection ${handle.id}`)),
+			...extensionHosts.map((handle) => withTimeout(handle.terminate(), `extension host ${handle.id}`)),
+			...terminals.map((handle) => withTimeout(handle.terminate(), `terminal ${handle.id}`))
+		]);
+		outcomes.forEach((outcome, index) => {
+			if (outcome.status === 'rejected') {
+				failures.push(outcome.reason instanceof Error ? outcome.reason.message : 'resource exit failed');
+				return;
+			}
+			if (index < management.length) {
+				releasedManagementConnections++;
+			} else if (index < management.length + extensionHosts.length) {
+				releasedExtensionHosts++;
+			} else {
+				releasedTerminals++;
+			}
+		});
+
+		// Only handles that reported exit are removed. A failed close keeps the record and
+		// the remaining handles for an explicit retry.
+		for (let i = 0; i < management.length; i++) {
+			if (outcomes[i].status === 'fulfilled') {
+				record.management.delete(management[i]);
+			}
+		}
+		for (let i = 0; i < extensionHosts.length; i++) {
+			if (outcomes[management.length + i].status === 'fulfilled') {
+				record.extensionHosts.delete(extensionHosts[i]);
+			}
+		}
+		for (let i = 0; i < terminals.length; i++) {
+			if (outcomes[management.length + extensionHosts.length + i].status === 'fulfilled') {
+				record.terminals.delete(terminals[i].id);
+			}
+		}
+		if (failures.length === 0 && record.terminals.size > 0) {
+			const late = [...record.terminals.keys()].join(', ');
+			failures.push(`terminal created while the view was closing: ${late}`);
+		}
+
+		const result: ManagedViewRuntimeClose = failures.length === 0
+			? {
+				state: 'CLOSED',
+				failures: [],
+				releasedManagementConnections,
+				releasedExtensionHosts,
+				releasedTerminals
+			}
+			: {
+				state: 'CLEANUP_FAILED',
+				failures,
+				releasedManagementConnections,
+				releasedExtensionHosts,
+				releasedTerminals
+			};
+		if (result.state === 'CLOSED') {
+			record.state = 'CLOSED';
+			record.failures = [];
+			record.lastClose = result;
+			this._logService.info(`[ManagedView] closed ${record.viewId} epoch ${record.bindingEpoch}`);
+		} else {
+			record.state = 'CLEANUP_FAILED';
+			record.failures = failures;
+			this._logService.error(`[ManagedView] close failed ${record.viewId}: ${failures.join('; ')}`);
+		}
+		return result;
+	}
+
+	private inspection(record: ViewRecord): ManagedViewRuntimeInspection {
+		return {
+			viewId: record.viewId,
+			bindingEpoch: record.bindingEpoch,
+			workspacePath: record.workspacePath,
+			state: record.state,
+			dirty: 'unknown',
+			draftBackup: { supported: false, reason: DRAFT_BACKUP_REASON },
+			managementConnections: Array.from(record.management, (handle) => ({ id: handle.id })),
+			extensionHosts: Array.from(record.extensionHosts, (handle) => ({ id: handle.id, pid: handle.pid })),
+			terminals: Array.from(record.terminals.values(), (handle) => ({ id: handle.id, pid: handle.pid })),
+			failures: [...record.failures]
+		};
+	}
+}
