+		// Freeze admissions before taking snapshots. Any in-flight resource still
+		// resolves against the old epoch and is either closed below or retained as
+		// a failure for an explicit retry.
+		record.state = 'CLOSING';
+		try {
+			await this.waitForPendingResources(record);
+		} catch (error) {
+			const message = `pending managed resources did not settle: ${error instanceof Error ? error.message : 'unknown error'}`;
+			record.state = 'CLEANUP_FAILED';
+			record.failures = [message];
+			this._logService.error(`[ManagedView] rebind failed ${viewId}: ${message}`);
+			return {
+				state: 'CLEANUP_FAILED',
+				failures: [message],
+				releasedManagementConnections: 0,
+				releasedExtensionHosts: 0,
+				preservedTerminals: record.terminals.size
+			};
+		}
+		const management = [...record.management];
+		const extensionHosts = [...record.extensionHosts];
+		const failures: string[] = [];
+		let releasedManagementConnections = 0;
+		let releasedExtensionHosts = 0;
+
+		const outcomes = await Promise.allSettled([
+			...management.map((handle) => withTimeout(handle.terminate(), `management connection ${handle.id}`)),
+			...extensionHosts.map((handle) => withTimeout(handle.terminate(), `extension host ${handle.id}`))
+		]);
+		outcomes.forEach((outcome, index) => {
+			if (outcome.status === 'rejected') {
+				failures.push(outcome.reason instanceof Error ? outcome.reason.message : 'resource exit failed');
+				return;
+			}
+			if (index < management.length) {
+				releasedManagementConnections++;
+			} else {
+				releasedExtensionHosts++;
+			}
+		});
+
+		// Old asynchronous detach callbacks can only remove the exact handle they
+		// own. Remove the fulfilled snapshot here as well; the epoch check in the
+		// detach methods prevents a late callback from touching the new binding.
+		for (let i = 0; i < management.length; i++) {
+			if (outcomes[i].status === 'fulfilled') {
+				record.management.delete(management[i]);
+			}
+		}
+		for (let i = 0; i < extensionHosts.length; i++) {
+			if (outcomes[management.length + i].status === 'fulfilled') {
+				record.extensionHosts.delete(extensionHosts[i]);
+			}
+		}
