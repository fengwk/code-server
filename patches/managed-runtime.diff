+	// The workspace snapshot can be taken before the workspace file has loaded.
+	// A configuration that finishes in that window must replace the snapshot,
+	// including its folder lookup map and transient flag, before initialization
+	// is marked complete.
+	test('refreshes a configuration-backed workspace snapshot when configuration initializes before assignment', async () => {
+		const workspaceService = testObject as unknown as {
+			workspaceConfiguration: {
+				initialized: boolean;
+				getFolders(): { path: string }[];
+				isTransient(): boolean;
+			};
+			updateWorkspaceAndInitializeConfiguration(workspace: Workspace & { initialized: boolean }, trigger: boolean): Promise<void>;
+		};
+		const configuration = workspaceService.workspaceConfiguration;
+		const initializedDuringCreate = configuration.initialized;
+		const folder = joinPath(ROOT, 'a');
+		const workspace = new Workspace('stale-snapshot', [], false, configResource, () => false) as Workspace & { initialized: boolean };
+		workspace.initialized = false;
+		let initializedDuringAssignment: boolean | undefined;
+		const originalGetFolders = configuration.getFolders.bind(configuration);
+		configuration.getFolders = () => {
+			initializedDuringAssignment = configuration.initialized;
+			return originalGetFolders();
+		};
+		configuration.initialized = true;
+		const originalIsTransient = configuration.isTransient.bind(configuration);
+		configuration.isTransient = () => true;
+
+		try {
+			await workspaceService.updateWorkspaceAndInitializeConfiguration(workspace, false);
+		} finally {
+			configuration.initialized = initializedDuringCreate;
+			configuration.getFolders = originalGetFolders;
+			configuration.isTransient = originalIsTransient;
+		}
+
+		assert.strictEqual(initializedDuringCreate, false);
+		assert.strictEqual(initializedDuringAssignment, true);
+		assert.strictEqual(workspace.initialized, true);
+		assert.strictEqual(workspace.transient, true);
+		assert.deepStrictEqual(workspace.folders.map(item => item.uri.toString()), [folder.toString(), joinPath(ROOT, 'b').toString()]);
+		assert.strictEqual(workspace.getFolder(joinPath(folder, 'file.txt'))?.uri.toString(), folder.toString());
+		assert.strictEqual(testObject.getWorkspace().folders.map(item => item.uri.toString()).join(','), workspace.folders.map(item => item.uri.toString()).join(','));
+	});
