+	class GatedConfigurationCache implements IConfigurationCache {
+		gate: 'open' | 'closed' = 'open';
+		holdUntilSnapshot = false;
+		private readonly values = new Map<string, string>();
+		private enteredResolve: (() => void) | undefined;
+		private heldResolve: (() => void) | undefined;
+		private releaseSnapshot: (() => void) | undefined;
+		readonly entered = new Promise<void>(resolve => { this.enteredResolve = resolve; });
+		readonly held = new Promise<void>(resolve => { this.heldResolve = resolve; });
+		needsCaching(): boolean { return true; }
+		seed(key: string, content: string): void { this.values.set(key, content); }
+		open(): void { this.gate = 'open'; }
+		releaseSnapshotHold(): void { this.releaseSnapshot?.(); }
+		async read(key: { key: string }): Promise<string> {
+			if (this.holdUntilSnapshot) {
+				this.holdUntilSnapshot = false;
+				this.heldResolve?.();
+				await new Promise<void>(resolve => { this.releaseSnapshot = resolve; });
+			}
+			if (this.gate === 'closed') {
+				this.enteredResolve?.();
+				await new Promise<void>(resolve => {
+					const original = this.open.bind(this);
+					this.open = () => { this.gate = 'open'; resolve(); original(); };
+				});
+			}
+			return this.values.get(key.key) ?? '';
+		}
+		async write(): Promise<void> { }
+		async remove(): Promise<void> { }
+	}
+});
